DATABASE_URL="mysql://root:@localhost:3306/nebeng"

DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="nebeng"

PORT=3000
NODE_ENV=development

JWT_SECRET=""
JWT_EXPIRES_IN="1d"

FRONTEND_URL="http://localhost:5173"

# Kredensial Xendit (Mode Uji Coba / Sandbox)
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# ------------------------------------------------------
# Email / SMTP (untuk reset password & notifikasi)
# ------------------------------------------------------
# Host SMTP (contoh: smtp.gmail.com, smtp.mailgun.org, smtp.sendgrid.net)
SMTP_HOST="smtp.gmail.com"
# Port (587 = STARTTLS / 465 = SSL)
SMTP_PORT=587
# true jika menggunakan SSL (port 465)
SMTP_SECURE=false
# Akun SMTP
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="app-password-atau-token"
# Alamat pengirim (opsional)
SMTP_FROM="Nebeng App <noreply@nebeng.local>"
# Hindari gagal terhubung ke self-signed cert (hanya untuk development)
SMTP_REJECT_UNAUTHORIZED=true

# Durasi token reset password (menit)
PASSWORD_RESET_EXPIRY_MINUTES=30

# ------------------------------------------------------
# OpenStreetMap & GPS Configuration
# ------------------------------------------------------
# Nominatim API URL (Geocoding)
OSM_NOMINATIM_API_URL="https://nominatim.openstreetmap.org"
# OSRM API URL (Route Calculation)
OSRM_API_URL="https://router.project-osrm.org"
# User Agent untuk Nominatim (wajib)
OSM_USER_AGENT="NebengApp/1.0"

# GPS Configuration
GPS_UPDATE_INTERVAL_SECONDS=30
GPS_RETENTION_MONTHS=3
GPS_DEVIATION_THRESHOLD_METERS=500
GEOFENCE_RADIUS_METERS=1000
ROUTE_CACHE_DAYS=7

# ------------------------------------------------------
# No-Show Configuration
# ------------------------------------------------------
# Grace period before marking no-show (minutes)
NO_SHOW_GRACE_MINUTES=15
# Dispute window for customer to contest no-show (hours)
DISPUTE_WINDOW_HOURS=24

# ------------------------------------------------------
# Firebase Cloud Messaging (FCM) Configuration
# ------------------------------------------------------
# Firebase Project ID from Firebase Console
FIREBASE_PROJECT_ID=""
# Firebase Client Email from Service Account JSON
FIREBASE_CLIENT_EMAIL=""
# Firebase Private Key from Service Account JSON (replace newlines with \n)
FIREBASE_PRIVATE_KEY=""
# Optional: FCM API Key (v1) for legacy support
FCM_API_KEY=""
# Feature flag to disable FCM (use Web Push instead)
USE_FCM="true"

# ------------------------------------------------------
# Web Push / VAPID Configuration
# ------------------------------------------------------
# Generate keys with: npx web-push generate-vapid-keys
# Public key for VAPID (shared with frontend)
VAPID_PUBLIC_KEY=""
# Private key for VAPID (keep secret!)
VAPID_PRIVATE_KEY=""
# Subject for VAPID (must be mailto: or https:)
VAPID_SUBJECT="mailto:admin@nebeng.com"
# Feature flag to enable/disable Web Push (if using FCM instead)
USE_WEB_PUSH="false"
